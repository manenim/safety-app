# Set true for explicit deterministic demo; false uses real services.
SIGNALCHECK_DEMO_MODE=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
DATABASE_URL=
# Server key: Places API (New), Geocoding API, Routes API. Never expose publicly.
GOOGLE_MAPS_API_KEY=
# Separate browser key: Maps JavaScript API, restricted to your website origins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional custom JavaScript map ID; DEMO_MAP_ID is used for the demo by default.
NEXT_PUBLIC_GOOGLE_MAP_ID=
# Required in live mode; generate unique random values. Never use NEXT_PUBLIC_.
COORDINATOR_PASSWORD=
SESSION_SECRET=
