{
  "name": "signalcheck",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "dev:demo": "SIGNALCHECK_DEMO_MODE=true SIGNALCHECK_DATA_DIR=.data/loom NEXT_DIST_DIR=.next-loom next dev --hostname 0.0.0.0 --port 3001",
    "seed:demo": "SIGNALCHECK_DEMO_MODE=true SIGNALCHECK_DATA_DIR=.data/loom tsx scripts/seed.ts",
    "seed:places": "tsx scripts/seed-google-places.ts --apply",
    "seed:judging": "tsx scripts/seed-google-places.ts --judging --apply",
    "seed:presentation": "tsx scripts/seed-google-places.ts --presentation --apply"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^2.1.3",
    "@supabase/supabase-js": "latest",
    "dotenv": "latest",
    "lucide-react": "latest",
    "next": "latest",
    "openai": "latest",
    "postgres": "latest",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/google.maps": "^3.66.3",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
